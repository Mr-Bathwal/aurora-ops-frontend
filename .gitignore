# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch artifact written by scripts/verify-shaders.mjs for a browser to fetch
/public/shader-probe.html

# Working captures — 158MB of debug screenshots taken while building. Regenerable
# from scripts/shoot.mjs and scripts/audit-final.mjs; not project content.
/screenshots/

# Throwaway one-off scripts from debugging sessions. The durable ones (shoot,
# audit-final, extract-robot, prep-constellation, check-overflow) are tracked.
/scripts/tmp-*.mjs
/scripts/.*-preview.png

# Machine-local Claude Code settings. launch.json IS tracked — it is shared config.
/.claude/settings.local.json

# PowerPoint lock files, created while a deck is open
~$*

# Generated slide renders — regenerate with deck/render-deck.ps1
/deck/render/

# Deck: throwaway render + fallback build (main deck and render/ are the tracked ones)
/deck/render-new/
/deck/*.new.pptx
